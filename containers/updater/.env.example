# Skopiuj do .env (chmod 600) i uzupelnij. Bez SMTP_HOST/MAIL_TO maile trafiaja do state/outbox/.
BASE_URL=https://updater.example.com
MAIL_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
UPDATER_HOST=updater.example.com
UPDATER_TLS_HOST=
LETSENCRYPT_EMAIL=
PROXY_NETWORK=homelab-proxy
APP_UID=1000
APP_GID=1000
