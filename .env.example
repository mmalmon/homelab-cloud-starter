# Copy this file to .env and replace the example passwords.
# Generate each secret separately with: openssl rand -hex 32

TZ=Etc/UTC
APPDATA_ROOT=./data
BIND_ADDRESS=127.0.0.1

NEXTCLOUD_IMAGE=nextcloud:35.0.2-apache
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
NEXTCLOUD_PORT=8080
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=replace-with-a-unique-random-secret
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=replace-with-a-different-random-secret

# Used only with: docker compose --profile photos up -d
IMMICH_VERSION=v3
IMMICH_PORT=2283
IMMICH_UPLOAD_LOCATION=./data/immich/library
IMMICH_DB_DATA_LOCATION=./data/immich/postgres
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=replace-with-another-unique-random-secret

# Optional hostnames used by stacks/reverse-proxy/nextcloud.override.yaml.
# Leave blank until DNS points to this server and the proxy is configured.
LETSENCRYPT_EMAIL=
NEXTCLOUD_HOST=
IMMICH_HOST=
