EURO_OFFICE_HOST=
LETSENCRYPT_EMAIL=
# Generate with: openssl rand -hex 32. Use the same value in the Nextcloud Office app.
EURO_OFFICE_JWT_SECRET=replace-with-at-least-32-random-characters
# Set true only when the trusted Nextcloud server is reachable at a private IP.
ALLOW_PRIVATE_IP_ADDRESS=false
